---
import { moodOptions } from "../data/trip";

const moodSuggestions: Record<string, { tag: string; tip: string }> = {
  surf: {
    tag: "Surf vandaag",
    tip: "Surf-spots staan nu aan op de kaart. Check de surf forecast voor My Khe in het Da Nang detail-blok."
  },
  werk: {
    tag: "Werk-focus",
    tip: "Co-working spots staan aan op de kaart. Doe een sessie bij The Hub of een cafe als 43 Factory."
  },
  verkennen: {
    tag: "Verkennen",
    tip: "Foto-spots en eet-tentjes staan aan op de kaart. Marble Mountains of Son Tra scooter rit zijn goeie keuzes."
  },
  chill: {
    tag: "Chill-modus",
    tip: "Eet-tentjes staan aan op de kaart. Pak een lokale spec, geen agenda."
  }
};
---

<section class="bg-[var(--color-night)] pt-8 sm:pt-10">
  <div class="max-w-3xl mx-auto px-5 sm:px-8">
    <div class="rounded-3xl bg-gradient-to-br from-[var(--color-azure)]/8 via-[var(--color-deep)] to-[var(--color-aqua)]/10 border border-[var(--color-line)] p-5 sm:p-6 soft-shadow">
      <div class="flex items-start justify-between gap-3 mb-4">
        <div>
          <div class="text-[10px] font-mono uppercase tracking-[0.2em] text-[var(--color-aqua)] mb-1">
            Vibe-check
          </div>
          <h3 class="font-display font-bold text-lg sm:text-2xl leading-tight tracking-tight text-[var(--color-ink)]">
            Wat voor dag is het?
          </h3>
          <p class="text-xs text-[var(--color-muted)] mt-1">
            Past de kaart-pins aan op wat je vandaag wilt doen
          </p>
        </div>
        <button type="button" data-mood-reset class="text-[10px] font-mono uppercase tracking-[0.15em] text-[var(--color-muted)] hover:text-[var(--color-ink)] transition hidden">
          Reset
        </button>
      </div>

      <div class="grid grid-cols-4 gap-2 sm:gap-3">
        {moodOptions.map((mood) => (
          <button
            type="button"
            data-mood={mood.id}
            class="mood-btn relative flex flex-col items-center gap-2 p-3 sm:p-4 rounded-2xl border border-[var(--color-line)] bg-[var(--color-deep)] hover:border-[var(--color-azure)]/40 active:scale-95 transition"
          >
            <span class="mood-icon w-10 h-10 sm:w-11 sm:h-11 rounded-xl grid place-items-center bg-[var(--color-azure)]/10 border border-[var(--color-azure)]/25 text-[var(--color-aqua)] transition">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={mood.icon} />
            </span>
            <span class="text-xs font-medium text-[var(--color-ink)]">{mood.label}</span>
          </button>
        ))}
      </div>

      <div data-mood-feedback class="hidden mt-4 rounded-2xl border border-[var(--color-azure)]/40 bg-[var(--color-azure)]/5 p-4 sm:p-5">
        <div class="flex items-start gap-3">
          <div class="w-9 h-9 rounded-xl grid place-items-center bg-[var(--color-azure)] text-white shrink-0">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          </div>
          <div class="min-w-0 flex-1">
            <div class="text-[10px] font-mono uppercase tracking-[0.18em] text-[var(--color-aqua)]" data-mood-tag></div>
            <p class="text-sm text-[var(--color-ink)] leading-relaxed mt-0.5" data-mood-tip></p>
            <a href="#kaart" class="inline-flex items-center gap-1.5 mt-3 text-xs font-medium text-[var(--color-azure)] hover:text-[var(--color-electric)] transition">
              Naar de kaart
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ moodSuggestions }}>
  (function () {
    const KEY = "vn-trip-mood";
    const today = new Date().toISOString().slice(0, 10);
    const stored = (() => {
      try {
        const raw = localStorage.getItem(KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        return parsed.date === today ? parsed.mood : null;
      } catch {
        return null;
      }
    })();

    const buttons = document.querySelectorAll("[data-mood]");
    const resetBtn = document.querySelector("[data-mood-reset]");
    const feedback = document.querySelector("[data-mood-feedback]");
    const tagEl = document.querySelector("[data-mood-tag]");
    const tipEl = document.querySelector("[data-mood-tip]");

    const apply = (id) => {
      buttons.forEach((b) => {
        const active = b.dataset.mood === id;
        b.classList.toggle("ring-2", active);
        b.classList.toggle("ring-[var(--color-azure)]", active);
        b.classList.toggle("border-[var(--color-azure)]/60", active);
        const icon = b.querySelector(".mood-icon");
        if (icon) {
          if (active) {
            icon.classList.add("bg-[var(--color-azure)]", "text-white");
            icon.classList.remove("bg-[var(--color-azure)]/10", "text-[var(--color-aqua)]");
          } else {
            icon.classList.remove("bg-[var(--color-azure)]", "text-white");
            icon.classList.add("bg-[var(--color-azure)]/10", "text-[var(--color-aqua)]");
          }
        }
      });

      if (id && moodSuggestions[id]) {
        if (tagEl) tagEl.textContent = moodSuggestions[id].tag;
        if (tipEl) tipEl.textContent = moodSuggestions[id].tip;
        feedback?.classList.remove("hidden");
      } else {
        feedback?.classList.add("hidden");
      }

      if (resetBtn) resetBtn.classList.toggle("hidden", !id);
      window.dispatchEvent(new CustomEvent("mood:change", { detail: id }));
    };

    buttons.forEach((b) => {
      b.addEventListener("click", () => {
        const id = b.dataset.mood;
        try {
          localStorage.setItem(KEY, JSON.stringify({ date: today, mood: id }));
        } catch {}
        apply(id);
      });
    });

    resetBtn?.addEventListener("click", () => {
      try { localStorage.removeItem(KEY); } catch {}
      apply(null);
    });

    if (stored) apply(stored);
  })();
</script>
