---
import { stops } from "../data/trip";

// Flatten photos per stop with metadata
type PhotoEntry = { src: string; stopId: string; stopCity: string };
const photos: PhotoEntry[] = stops.flatMap((s) =>
  (s.photos || []).map((src) => ({ src, stopId: s.id, stopCity: s.city }))
);

const hasPhotos = photos.length > 0;
---

<section id="fotos" class="relative bg-[var(--color-night)] py-14 sm:py-20">
  <div class="max-w-3xl mx-auto px-5 sm:px-8">
    <div class="flex items-end justify-between gap-3 mb-6 sm:mb-8">
      <div>
        <div class="text-xs font-mono uppercase tracking-[0.22em] text-[var(--color-aqua)] mb-2">
          Foto-tijdlijn
        </div>
        <h2 class="font-display font-bold text-3xl sm:text-5xl leading-[1] tracking-tight">
          Wat ik heb gezien.
        </h2>
      </div>
      {hasPhotos && (
        <span class="text-[10px] font-mono uppercase tracking-[0.15em] text-[var(--color-muted)] mb-1">
          {photos.length} foto's
        </span>
      )}
    </div>

    {hasPhotos ? (
      <div class="space-y-10">
        {stops.map((s) =>
          s.photos && s.photos.length > 0 ? (
            <div>
              <div class="flex items-center gap-3 mb-3">
                <div class="w-8 h-8 rounded-full grid place-items-center bg-[var(--color-azure)] text-white text-xs font-display font-bold">
                  {stops.indexOf(s) + 1}
                </div>
                <div>
                  <div class="font-display font-bold text-lg text-[var(--color-ink)]">{s.city}</div>
                  <div class="text-[10px] font-mono uppercase tracking-[0.15em] text-[var(--color-muted)]">{s.arrival} – {s.departure}</div>
                </div>
              </div>
              <div class="grid grid-cols-3 sm:grid-cols-4 gap-1.5 sm:gap-2">
                {s.photos.map((src) => (
                  <a href={src} target="_blank" rel="noopener" class="relative aspect-square rounded-xl overflow-hidden bg-[var(--color-card)] group">
                    <img src={src} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform group-hover:scale-105" loading="lazy" decoding="async" />
                  </a>
                ))}
              </div>
            </div>
          ) : null
        )}
      </div>
    ) : (
      <div class="rounded-3xl bg-white border border-dashed border-[var(--color-line-strong)] p-8 sm:p-12 text-center soft-shadow">
        <div class="mx-auto mb-4 w-14 h-14 rounded-2xl grid place-items-center bg-[var(--color-azure)]/10 border border-[var(--color-azure)]/25">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-aqua)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.5-3.5-9 9"/>
          </svg>
        </div>
        <h3 class="font-display font-bold text-xl text-[var(--color-ink)] mb-2">
          Nog geen foto's
        </h3>
        <p class="text-sm text-[var(--color-ink-soft)] max-w-md mx-auto leading-relaxed">
          Tijdens de trip drop je foto's in <span class="font-mono text-[var(--color-aqua)]">/public/uploads/photos/&#123;stop-id&#125;/</span> en voeg je ze toe in <span class="font-mono text-[var(--color-aqua)]">src/data/trip.ts</span> bij de stop. De tijdlijn groeit dan automatisch.
        </p>
      </div>
    )}
  </div>
</section>
