---
import { trip } from "../data/trip";
---

<section class="relative bg-[var(--color-deep)] border-y border-[var(--color-line)]">
  <div class="max-w-3xl mx-auto px-3 sm:px-8 py-3 sm:py-3.5">
    <div class="grid grid-cols-3 divide-x divide-[var(--color-line)]">
      <div class="text-center px-1.5 sm:px-3">
        <div class="text-[9px] font-mono uppercase tracking-[0.12em] text-[var(--color-muted)] mb-0.5 leading-tight" data-countdown-label>tot vertrek</div>
        <div class="font-display font-bold text-base sm:text-lg tnum text-[var(--color-ink)] leading-none" data-countdown>...</div>
      </div>
      <div class="text-center px-1.5 sm:px-3">
        <div class="text-[9px] font-mono uppercase tracking-[0.12em] text-[var(--color-muted)] mb-0.5 leading-tight">VN / NL</div>
        <div class="font-display font-bold text-sm sm:text-lg tnum text-[var(--color-ink)] leading-none whitespace-nowrap">
          <span data-time-vn>...</span><span class="text-[var(--color-muted)] mx-0.5 font-normal">/</span><span data-time-nl class="text-[var(--color-muted)]">...</span>
        </div>
      </div>
      <div class="text-center px-1.5 sm:px-3">
        <div class="text-[9px] font-mono uppercase tracking-[0.12em] text-[var(--color-muted)] mb-0.5 leading-tight">1 EUR =</div>
        <div class="font-display font-bold text-sm sm:text-lg tnum text-[var(--color-ink)] leading-none whitespace-nowrap" data-rate>...</div>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ startDate: trip.startDate }}>
  (function () {
    const fmtTime = (tz) => {
      try {
        return new Intl.DateTimeFormat("nl-NL", {
          hour: "2-digit",
          minute: "2-digit",
          timeZone: tz,
          hour12: false
        }).format(new Date());
      } catch {
        return "...";
      }
    };

    const updateClocks = () => {
      const vn = document.querySelector("[data-time-vn]");
      const nl = document.querySelector("[data-time-nl]");
      if (vn) vn.textContent = fmtTime("Asia/Ho_Chi_Minh");
      if (nl) nl.textContent = fmtTime("Europe/Amsterdam");
    };

    const updateCountdown = () => {
      const start = new Date(startDate + "T00:00:00");
      const now = new Date();
      const diff = Math.ceil((start.getTime() - now.getTime()) / (1000 * 60 * 60 * 24));
      const cd = document.querySelector("[data-countdown]");
      const cdLabel = document.querySelector("[data-countdown-label]");
      if (!cd || !cdLabel) return;
      if (diff > 0) {
        cd.textContent = `${diff}d`;
        cdLabel.textContent = "tot vertrek";
      } else if (diff === 0) {
        cd.textContent = "vandaag";
        cdLabel.textContent = "boarding day";
      } else if (diff >= -25) {
        cd.textContent = `dag ${Math.abs(diff)}`;
        cdLabel.textContent = "onderweg";
      } else {
        cd.textContent = "done";
        cdLabel.textContent = "trip voorbij";
      }
    };

    const fetchRate = async () => {
      const cached = sessionStorage.getItem("vn-rate-eur-vnd");
      const cachedTs = sessionStorage.getItem("vn-rate-ts");
      const rateEl = document.querySelector("[data-rate]");
      if (!rateEl) return;

      const compact = (vnd) => {
        if (vnd >= 1000) return (vnd / 1000).toFixed(1).replace(/\.0$/, "") + "k ₫";
        return Math.round(vnd) + " ₫";
      };

      if (cached && cachedTs && Date.now() - Number(cachedTs) < 3600 * 1000) {
        rateEl.textContent = compact(Number(cached));
        return;
      }

      try {
        const res = await fetch("https://open.er-api.com/v6/latest/EUR");
        if (!res.ok) throw new Error();
        const data = await res.json();
        const vnd = data?.rates?.VND;
        if (typeof vnd !== "number") throw new Error();
        rateEl.textContent = compact(vnd);
        sessionStorage.setItem("vn-rate-eur-vnd", String(vnd));
        sessionStorage.setItem("vn-rate-ts", String(Date.now()));
      } catch {
        rateEl.textContent = "~27k ₫";
      }
    };

    updateClocks();
    updateCountdown();
    fetchRate();
    setInterval(updateClocks, 30000);
  })();
</script>
