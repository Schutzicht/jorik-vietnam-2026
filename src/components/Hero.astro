---
import { trip, stops } from "../data/trip";

const totalNights = stops.reduce((sum, s) => sum + s.nights, 0);
---

<section id="top" class="relative h-[78svh] sm:h-[92svh] min-h-[540px] flex flex-col overflow-hidden">
  <img
    src={trip.heroImage}
    alt=""
    class="absolute inset-0 w-full h-full object-cover"
    style="object-position: 50% 45%;"
    loading="eager"
    decoding="async"
    fetchpriority="high"
  />
  <div class="absolute inset-0 gradient-hero-overlay"></div>

  <nav class="relative z-10 px-5 sm:px-8 pt-5 sm:pt-7 flex items-center justify-between">
    <span class="text-xs sm:text-sm font-medium tracking-[0.05em] text-white/95" style="text-shadow: 0 1px 3px rgba(0,0,0,0.4);">
      Vietnam <span class="text-white/60 font-normal mx-1">·</span> Okt '26
    </span>
    <div class="hidden md:flex items-center gap-7 text-sm">
      <a href="#kaart" class="text-white/80 hover:text-white transition" style="text-shadow: 0 1px 3px rgba(0,0,0,0.4);">Route</a>
      <a href="#stops" class="text-white/80 hover:text-white transition" style="text-shadow: 0 1px 3px rgba(0,0,0,0.4);">Stops</a>
      <a href="#praktisch" class="text-white/80 hover:text-white transition" style="text-shadow: 0 1px 3px rgba(0,0,0,0.4);">Info</a>
    </div>
  </nav>

  <div class="relative z-10 flex-1 flex flex-col justify-end px-5 sm:px-8 pb-10 sm:pb-16 max-w-7xl mx-auto w-full">
    <div class="text-[10px] sm:text-xs font-mono uppercase tracking-[0.22em] text-white/85 mb-3" style="text-shadow: 0 1px 3px rgba(0,0,0,0.4);">
      Solo · {totalNights} nachten · 3 stops
    </div>
    <h1 class="font-display font-bold text-[18vw] sm:text-[9rem] md:text-[11rem] leading-[0.82] tracking-[-0.04em] text-white" style="text-shadow: 0 4px 24px rgba(0,0,0,0.35);">
      Vietnam
    </h1>
    <p class="mt-4 sm:mt-6 max-w-md text-base sm:text-lg text-white/90 italic font-light" style="text-shadow: 0 1px 3px rgba(0,0,0,0.4);">
      {trip.intent}
    </p>
  </div>

  <button
    type="button"
    onclick="document.getElementById('kaart')?.scrollIntoView({behavior:'smooth'})"
    class="absolute bottom-5 left-1/2 -translate-x-1/2 z-10 w-10 h-10 rounded-full bg-white/15 backdrop-blur-md border border-white/30 grid place-items-center text-white hover:bg-white/25 hover:scale-110 transition"
    aria-label="Scroll naar route"
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 5v14"/><path d="m19 12-7 7-7-7"/>
    </svg>
  </button>
</section>
