---
import { packingPlan } from "../data/trip";

const phaseIcons: Record<string, string> = {
  "Voor vertrek": '<polyline points="20 6 9 17 4 12"/>',
  "In bagage": '<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>'
};
---

<section id="lists" class="relative bg-[var(--color-deep)] py-14 sm:py-20 border-y border-[var(--color-line)]">
  <div class="max-w-3xl mx-auto px-5 sm:px-8">
    <div class="flex items-end justify-between gap-3 mb-6 sm:mb-8">
      <div>
        <div class="text-xs font-mono uppercase tracking-[0.22em] text-[var(--color-aqua)] mb-2">
          Checklists
        </div>
        <h2 class="font-display font-bold text-3xl sm:text-5xl leading-[1] tracking-tight">
          Wat moet mee.
        </h2>
        <p class="mt-3 text-sm text-[var(--color-ink-soft)] max-w-md">
          Twee fases: eerst regelen, dan inpakken. Vink af terwijl je het doet, state blijft staan in je browser.
        </p>
      </div>
      <button type="button" data-checklist-reset class="text-[10px] font-mono uppercase tracking-[0.15em] text-[var(--color-muted)] hover:text-[var(--color-coral)] transition mb-1">
        Reset alles
      </button>
    </div>

    <div class="space-y-8 sm:space-y-10">
      {packingPlan.map((phase, pi) => (
        <div>
          <div class="flex items-center gap-3 mb-3 sm:mb-4">
            <div class="w-10 h-10 rounded-2xl grid place-items-center bg-[var(--color-azure)] text-white shrink-0">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={phaseIcons[phase.phase] || ""} />
            </div>
            <div>
              <div class="text-[10px] font-mono uppercase tracking-[0.18em] text-[var(--color-aqua)]">Fase {pi + 1}</div>
              <h3 class="font-display font-bold text-xl sm:text-2xl text-[var(--color-ink)] leading-tight">{phase.phase}</h3>
              <p class="text-xs text-[var(--color-muted)]">{phase.subtitle}</p>
            </div>
          </div>

          <div class="rounded-3xl bg-white border border-[var(--color-line)] overflow-hidden soft-shadow">
            {phase.groups.map((group, gi) => {
              const groupId = `p${pi}-g${gi}`;
              return (
                <details class="group border-b border-[var(--color-line)] last:border-b-0" open={pi === 0 && gi === 0}>
                  <summary class={`flex items-center justify-between gap-4 p-4 sm:p-5 cursor-pointer list-none hover:bg-[var(--color-night)]/50 transition-colors ${group.critical ? "bg-[var(--color-coral)]/[0.04]" : ""}`}>
                    <div class="flex items-center gap-3 min-w-0">
                      <div class={`w-9 h-9 rounded-xl grid place-items-center shrink-0 ${group.critical ? "bg-[var(--color-coral)]/15 border border-[var(--color-coral)]/30" : "bg-[var(--color-azure)]/10 border border-[var(--color-azure)]/25"}`}>
                        <span class={`text-[10px] font-mono font-bold tabular-nums ${group.critical ? "text-[var(--color-coral)]" : "text-[var(--color-aqua)]"}`} data-checklist-count={groupId}>0/{group.items.length}</span>
                      </div>
                      <div class="min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                          <span class="text-sm sm:text-base font-semibold text-[var(--color-ink)]">{group.category}</span>
                          {group.critical && (
                            <span class="text-[9px] font-mono uppercase tracking-[0.15em] text-[var(--color-coral)] bg-[var(--color-coral)]/10 border border-[var(--color-coral)]/30 px-2 py-0.5 rounded-full">Essentieel</span>
                          )}
                        </div>
                      </div>
                    </div>
                    <svg class="shrink-0 transition-transform group-open:rotate-180" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-muted)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m6 9 6 6 6-6"/>
                    </svg>
                  </summary>
                  <ul class="px-4 sm:px-5 pb-4 sm:pb-5 space-y-1">
                    {group.items.map((item, idx) => {
                      const key = `${groupId}-${idx}`;
                      return (
                        <li>
                          <label class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-[var(--color-night)]/40 cursor-pointer transition-colors">
                            <input
                              type="checkbox"
                              data-checklist-item={key}
                              data-checklist-group={groupId}
                              class={`mt-0.5 w-5 h-5 rounded border-2 border-[var(--color-line-strong)] focus:ring-2 cursor-pointer shrink-0 ${group.critical ? "text-[var(--color-coral)] focus:ring-[var(--color-coral)]" : "text-[var(--color-azure)] focus:ring-[var(--color-azure)]"}`}
                            />
                            <span class="text-sm text-[var(--color-ink)] leading-relaxed">{item}</span>
                          </label>
                        </li>
                      );
                    })}
                  </ul>
                </details>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const KEY = "vn-checklist-state-v2";
    const load = () => {
      try { return JSON.parse(localStorage.getItem(KEY) || "{}"); } catch { return {}; }
    };
    const save = (state) => {
      try { localStorage.setItem(KEY, JSON.stringify(state)); } catch {}
    };

    let state = load();
    const items = document.querySelectorAll("[data-checklist-item]");

    const updateGroupCount = (groupId) => {
      const groupItems = document.querySelectorAll(`[data-checklist-group="${groupId}"]`);
      const total = groupItems.length;
      const checked = Array.from(groupItems).filter((i) => i.checked).length;
      const badge = document.querySelector(`[data-checklist-count="${groupId}"]`);
      if (badge) badge.textContent = `${checked}/${total}`;
    };

    items.forEach((input) => {
      const key = input.dataset.checklistItem;
      const group = input.dataset.checklistGroup;
      if (state[key]) input.checked = true;
      const label = input.closest("label");
      const span = label?.querySelector("span");
      const updateVisual = () => {
        if (span) {
          if (input.checked) {
            span.classList.add("line-through", "text-[var(--color-muted)]");
          } else {
            span.classList.remove("line-through", "text-[var(--color-muted)]");
          }
        }
      };
      updateVisual();
      input.addEventListener("change", () => {
        state[key] = input.checked;
        save(state);
        updateVisual();
        if (group) updateGroupCount(group);
      });
    });

    const groups = new Set(Array.from(items).map((i) => i.dataset.checklistGroup));
    groups.forEach((g) => updateGroupCount(g));

    document.querySelector("[data-checklist-reset]")?.addEventListener("click", () => {
      if (!confirm("Alle checkboxen unchecken?")) return;
      state = {};
      save(state);
      items.forEach((i) => {
        i.checked = false;
        const span = i.closest("label")?.querySelector("span");
        span?.classList.remove("line-through", "text-[var(--color-muted)]");
      });
      groups.forEach((g) => updateGroupCount(g));
    });
  })();
</script>
