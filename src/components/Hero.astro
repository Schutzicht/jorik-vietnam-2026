---
import { trip, stops } from "../data/trip";

const totalNights = stops.reduce((sum, s) => sum + s.nights, 0);
---

<section id="top" class="relative h-[88svh] sm:h-[92svh] min-h-[560px] flex flex-col overflow-hidden">
  <img
    src={trip.heroImage}
    alt=""
    class="absolute inset-0 w-full h-full object-cover"
    loading="eager"
    decoding="async"
    fetchpriority="high"
  />
  <div class="absolute inset-0 gradient-hero-overlay"></div>

  <nav class="relative z-10 px-5 sm:px-8 pt-5 sm:pt-7 flex items-center justify-between">
    <div class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-xl grid place-items-center font-display font-bold text-sm bg-[var(--color-azure)] text-white">V</div>
      <span class="text-sm font-medium tracking-tight">Vietnam <span class="text-[var(--color-muted)] font-normal">· {trip.window}</span></span>
    </div>
    <div class="hidden md:flex items-center gap-7 text-sm">
      <a href="#kaart" class="text-[var(--color-ink-soft)] hover:text-[var(--color-foam)] transition">Route</a>
      <a href="#stops" class="text-[var(--color-ink-soft)] hover:text-[var(--color-foam)] transition">Stops</a>
      <a href="#praktisch" class="text-[var(--color-ink-soft)] hover:text-[var(--color-foam)] transition">Info</a>
    </div>
  </nav>

  <div class="relative z-10 flex-1 flex flex-col justify-end px-5 sm:px-8 pb-10 sm:pb-16 max-w-7xl mx-auto w-full">
    <div class="text-xs font-mono uppercase tracking-[0.22em] text-[var(--color-aqua)] mb-3">
      Solo · {totalNights} nachten · 3 stops
    </div>
    <h1 class="font-display font-bold text-[18vw] sm:text-[9rem] md:text-[11rem] leading-[0.82] tracking-[-0.04em] text-[var(--color-foam)]">
      Vietnam
    </h1>
    <p class="mt-4 sm:mt-6 max-w-md text-base sm:text-lg text-[var(--color-foam)]/85 italic font-light">
      {trip.intent}
    </p>
  </div>

  <button
    type="button"
    onclick="document.getElementById('kaart')?.scrollIntoView({behavior:'smooth'})"
    class="absolute bottom-5 left-1/2 -translate-x-1/2 z-10 w-10 h-10 rounded-full glass grid place-items-center text-[var(--color-foam)] hover:scale-110 transition"
    aria-label="Scroll naar route"
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 5v14"/><path d="m19 12-7 7-7-7"/>
    </svg>
  </button>
</section>
