---
import { profile } from "../data/trip";

const traits = [
  { label: "Surf", value: profile.surfLevel, icon: '<path d="M2 16c3-2 5-2 8 0s5 2 8 0 3-2 4-2"/><path d="M6 11c2 0 3 2 6 2s4-2 6-2 2 1 4 1"/>' },
  { label: "Werk", value: profile.workHours, icon: '<rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 18v3"/>' },
  { label: "Sociaal", value: profile.socialMode, icon: '<circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M3 20c0-3 3-5 6-5s6 2 6 5"/><path d="M14 20c0-2 2-4 5-4"/>' },
  { label: "Eet", value: profile.eatStyle, icon: '<path d="M4 11h16v3a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4z"/><path d="M8 7v3"/><path d="M12 5v5"/><path d="M16 7v3"/>' },
  { label: "Ritme", value: profile.rhythm, icon: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>' },
  { label: "Slapen", value: profile.stayStyle, icon: '<path d="M3 12 12 4l9 8"/><path d="M5 10v10h14V10"/>' }
];
---

<section class="relative bg-[var(--color-night)] py-8 sm:py-12">
  <div class="max-w-3xl mx-auto px-5 sm:px-8">
    <div class="rounded-3xl bg-white border border-[var(--color-line)] overflow-hidden soft-shadow">
      <div class="relative h-44 sm:h-56 overflow-hidden">
        <img
          src="/profile-cover.jpg"
          alt=""
          class="absolute inset-0 w-full h-full object-cover"
          style="object-position: 50% 60%;"
          loading="lazy"
          decoding="async"
        />
        <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0) 55%, rgba(255,255,255,0.95) 100%);"></div>
        <div class="absolute top-4 left-4 px-3 py-1.5 rounded-full glass-dark text-[10px] font-mono uppercase tracking-[0.15em] text-white">
          Surf, eerder dit jaar
        </div>
      </div>

      <div class="relative px-5 sm:px-7 pb-1">
        <div class="flex items-end gap-4 -mt-12 sm:-mt-14 mb-4">
          <div class="shrink-0 w-24 h-24 sm:w-28 sm:h-28 rounded-full overflow-hidden border-4 border-white shadow-[0_8px_24px_-8px_rgba(12,37,64,0.3)] bg-gradient-to-br from-[var(--color-azure)] to-[var(--color-ocean)] grid place-items-center">
            <img
              src="/profile.jpg"
              alt={profile.name}
              class="w-full h-full object-cover"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />
            <span class="hidden w-full h-full items-center justify-center font-display font-bold text-3xl text-white" aria-hidden="true">{profile.name.charAt(0)}</span>
          </div>
          <div class="min-w-0 pb-2">
            <div class="text-[10px] font-mono uppercase tracking-[0.22em] text-[var(--color-aqua)] mb-1">
              Reis op maat
            </div>
            <h2 class="font-display font-bold text-2xl sm:text-3xl leading-tight tracking-tight text-[var(--color-ink)]">
              Hoe ik <span class="italic font-light text-[var(--color-azure)]">reis</span>.
            </h2>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 divide-x divide-y divide-[var(--color-line)]">
        {traits.map((trait) => (
          <div class="p-4 sm:p-5 flex items-start gap-3">
            <div class="w-9 h-9 rounded-xl grid place-items-center bg-[var(--color-azure)]/10 border border-[var(--color-azure)]/25 shrink-0">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--color-aqua)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={trait.icon} />
            </div>
            <div class="min-w-0">
              <div class="text-[10px] font-mono uppercase tracking-[0.15em] text-[var(--color-muted)] mb-0.5">
                {trait.label}
              </div>
              <div class="text-sm font-medium text-[var(--color-ink)] leading-tight">
                {trait.value}
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="border-t border-[var(--color-line)] p-4 sm:p-5 bg-[var(--color-night)]/50">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
          <div class="flex items-center gap-3 min-w-0">
            <div class="w-9 h-9 rounded-xl grid place-items-center bg-[var(--color-coral)]/15 border border-[var(--color-coral)]/30 shrink-0">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--color-coral)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <div class="min-w-0">
              <div class="text-[10px] font-mono uppercase tracking-[0.15em] text-[var(--color-muted)] mb-0.5">
                Vibe-referentie
              </div>
              <div class="text-sm font-medium text-[var(--color-ink)]">
                {profile.vibeReference} <span class="text-[var(--color-muted)] font-normal">· content getuned op die energie</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="border-t border-[var(--color-line)] p-4 sm:p-5">
        <div class="text-[10px] font-mono uppercase tracking-[0.15em] text-[var(--color-muted)] mb-2">
          Eerder in Zuidoost-Azië
        </div>
        <div class="flex flex-wrap gap-2">
          {profile.seaExperience.map((place) => (
            <span class="px-3 py-1.5 rounded-full bg-[var(--color-azure)]/10 border border-[var(--color-azure)]/25 text-xs text-[var(--color-ink)]">
              {place}
            </span>
          ))}
        </div>
        <p class="mt-3 text-xs text-[var(--color-muted)] leading-relaxed">
          Je kent de regio al. De tips hieronder slaan de SEA-basics over en gaan dieper op wat aan Vietnam specifiek is.
        </p>
      </div>
    </div>
  </div>
</section>
