---
import type { Stop } from "../data/trip";
import SurfForecast from "./SurfForecast.astro";

interface Props {
  stop: Stop;
  index: number;
  isHome: boolean;
  isLast: boolean;
}
const { stop, index, isHome, isLast } = Astro.props;

const overviewBlocks = [
  { ...stop.stay, icon: "stay" },
  { ...stop.cowork, icon: "cowork" },
  ...(stop.surf ? [{ ...stop.surf, icon: "surf" }] : []),
  { ...stop.food, icon: "food" },
  { ...stop.people, icon: "people" },
  { ...stop.todo, icon: "todo" }
];

const iconPath = (name: string) => {
  switch (name) {
    case "stay": return '<path d="M3 12 12 4l9 8"/><path d="M5 10v10h14V10"/>';
    case "cowork": return '<rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 18v3"/>';
    case "surf": return '<path d="M2 16c3-2 5-2 8 0s5 2 8 0 3-2 4-2"/><path d="M6 11c2 0 3 2 6 2s4-2 6-2 2 1 4 1"/>';
    case "food": return '<path d="M4 11h16v3a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4z"/><path d="M8 7v3"/><path d="M12 5v5"/><path d="M16 7v3"/>';
    case "people": return '<circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M3 20c0-3 3-5 6-5s6 2 6 5"/><path d="M14 20c0-2 2-4 5-4"/>';
    case "todo": return '<polyline points="4 12 9 17 20 6"/>';
    default: return "";
  }
};
---

<div class="relative" id={`stop-${stop.id}`}>
  <div class="absolute left-5 sm:left-7 -top-3 z-20">
    <div class={`w-10 h-10 sm:w-12 sm:h-12 rounded-full grid place-items-center font-display font-bold text-sm sm:text-base ring-4 ring-[var(--color-night)] ${isHome ? "bg-[var(--color-coral)] text-white" : "bg-[var(--color-azure)] text-white"}`}>
      {String(index).padStart(2, "0")}
    </div>
  </div>

  {!isLast && (
    <div
      class="absolute left-[39px] sm:left-[51px] top-12 sm:top-14 bottom-[-60px] sm:bottom-[-80px] w-px"
      style="background: linear-gradient(to bottom, var(--color-azure) 0%, var(--color-line-strong) 100%); opacity: 0.5;"
      aria-hidden="true"
    ></div>
  )}

  <article
    data-stop-card
    data-stop-id={stop.id}
    class="ml-0 sm:ml-0 rounded-3xl overflow-hidden bg-[var(--color-deep)] border border-[var(--color-line)] hover:border-[var(--color-azure)]/40 transition-colors"
  >
    <button
      type="button"
      data-stop-toggle
      class="w-full text-left group"
      aria-expanded="false"
    >
      <div class="relative h-56 sm:h-72 md:h-80 overflow-hidden">
        <img
          src={stop.image}
          alt={stop.city}
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          loading="lazy"
          decoding="async"
        />
        <div class="absolute inset-0 gradient-card-overlay"></div>

        {isHome && (
          <div class="absolute top-4 right-4 px-3 py-1.5 rounded-full bg-[var(--color-coral)]/20 backdrop-blur-md border border-[var(--color-coral)]/50 text-[10px] sm:text-xs font-mono uppercase tracking-[0.15em] text-[var(--color-coral)]">
            Homebase
          </div>
        )}

        <div class="absolute bottom-4 left-4 right-4 sm:bottom-5 sm:left-6 sm:right-6">
          <div class="text-[10px] font-mono uppercase tracking-[0.2em] text-[var(--color-aqua)] mb-1.5">
            {stop.region}
          </div>
          <h3 class="font-display font-bold text-[12vw] sm:text-6xl md:text-7xl leading-[0.85] tracking-[-0.03em] text-white">
            {stop.city}
          </h3>
        </div>
      </div>

      <div class="p-5 sm:p-6 flex items-center justify-between gap-4">
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-mono uppercase tracking-[0.15em] text-[var(--color-aqua)]">
            <span>{stop.arrival} → {stop.departure}</span>
            <span class="text-[var(--color-muted)]">·</span>
            <span>{stop.nights}n</span>
          </div>
          <p class="mt-1.5 text-sm sm:text-base text-[var(--color-ink)] font-medium leading-snug">
            {stop.tagline}
          </p>
        </div>
        <div class="shrink-0 w-10 h-10 rounded-full grid place-items-center bg-[var(--color-azure)]/10 border border-[var(--color-azure)]/30 transition-transform" data-toggle-chevron>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-aqua)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </div>
      </div>
    </button>

    <div data-stop-detail class="hidden">
      <div class="border-t border-[var(--color-line)]">
        <div class="flex gap-1 p-2 overflow-x-auto no-scrollbar" role="tablist" data-tabs={stop.id}>
          {["Overzicht", "Dagen", "Notities", "Documenten", "Foto's"].map((label, i) => (
            <button
              type="button"
              role="tab"
              data-tab-id={i}
              aria-selected={i === 0 ? "true" : "false"}
              class={`shrink-0 px-4 py-2.5 rounded-2xl text-sm font-medium transition ${
                i === 0
                  ? "bg-[var(--color-azure)] text-white shadow-[0_4px_12px_-2px_rgba(2,132,199,0.35)]"
                  : "text-[var(--color-ink-soft)] hover:bg-[var(--color-card)]"
              }`}
            >
              {label}
            </button>
          ))}
        </div>

        <div role="tabpanel" data-tab-panel="0" class="p-5 sm:p-6 pt-2">
          <p class="text-sm sm:text-base text-[var(--color-ink-soft)] leading-relaxed mb-5">
            {stop.vibe}
          </p>

          <div class="mb-6">
            <div class="text-[10px] font-mono uppercase tracking-[0.2em] text-[var(--color-aqua)] mb-2">Highlights</div>
            <div class="flex flex-wrap gap-2">
              {stop.highlights.map((h) => (
                <span class="px-3 py-1.5 rounded-full bg-[var(--color-azure)]/10 border border-[var(--color-azure)]/30 text-xs sm:text-sm text-[var(--color-ink)]">
                  {h}
                </span>
              ))}
            </div>
          </div>

          {stop.id === "danang" && (
            <div class="mb-6">
              <SurfForecast />
            </div>
          )}

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {overviewBlocks.map((block) => (
              <details class="group bg-[var(--color-night)] border border-[var(--color-line)] rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between gap-3 p-4 cursor-pointer list-none">
                  <div class="flex items-center gap-3 min-w-0">
                    <div class="w-8 h-8 rounded-lg grid place-items-center bg-[var(--color-azure)]/10 border border-[var(--color-azure)]/30 shrink-0">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-aqua)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconPath(block.icon)} />
                    </div>
                    <span class="text-sm font-semibold text-[var(--color-ink)]">{block.title}</span>
                  </div>
                  <svg class="shrink-0 transition-transform group-open:rotate-180" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-muted)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m6 9 6 6 6-6"/>
                  </svg>
                </summary>
                <ul class="px-4 pb-4 pl-[60px] space-y-1.5 text-sm text-[var(--color-ink-soft)]">
                  {block.items.map((item) => (
                    <li class="flex gap-2"><span class="text-[var(--color-muted)] shrink-0">·</span>{item}</li>
                  ))}
                </ul>
              </details>
            ))}
          </div>

          {stop.sideTrips && stop.sideTrips.length > 0 && (
            <div class="mt-6">
              <div class="text-[10px] font-mono uppercase tracking-[0.2em] text-[var(--color-aqua)] mb-3">Side trips</div>
              <div class="flex gap-3 overflow-x-auto snap-x-px no-scrollbar -mx-5 sm:mx-0 px-5 sm:px-0 pb-2">
                {stop.sideTrips.map((side) => (
                  <div class="snap-item shrink-0 w-[72%] sm:w-[280px] rounded-2xl overflow-hidden bg-[var(--color-night)] border border-[var(--color-line)]">
                    {side.image && (
                      <div class="relative h-32 overflow-hidden">
                        <img src={side.image} alt={side.name} class="absolute inset-0 w-full h-full object-cover" loading="lazy" decoding="async" />
                      </div>
                    )}
                    <div class="p-4">
                      <div class="flex items-baseline justify-between gap-2 mb-1">
                        <h5 class="font-display font-bold text-base text-[var(--color-ink)]">{side.name}</h5>
                        <span class="text-[10px] font-mono uppercase tracking-[0.15em] text-[var(--color-aqua)] whitespace-nowrap">{side.duration}</span>
                      </div>
                      <div class="text-[10px] text-[var(--color-muted)] mb-2 font-mono">{side.distance}</div>
                      <p class="text-xs text-[var(--color-ink-soft)] leading-relaxed line-clamp-3">{side.description}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>

        <div role="tabpanel" data-tab-panel="1" class="p-5 sm:p-6 pt-2 hidden">
          <div class="mb-4">
            <div class="text-sm font-semibold text-[var(--color-ink)]">Dagen plannen</div>
            <div class="text-xs text-[var(--color-muted)]">Per dag een korte planning, lokaal opgeslagen</div>
          </div>
          <div class="space-y-3">
            {Array.from({ length: stop.nights }, (_, i) => i + 1).map((dayNum) => (
              <details class="group bg-[var(--color-night)] border border-[var(--color-line)] rounded-2xl overflow-hidden">
                <summary class="flex items-center gap-3 p-4 cursor-pointer list-none">
                  <span class="w-8 h-8 rounded-lg grid place-items-center bg-[var(--color-azure)]/10 border border-[var(--color-azure)]/30 text-xs font-display font-bold text-[var(--color-aqua)]">D{dayNum}</span>
                  <span class="flex-1 text-sm font-medium text-[var(--color-ink)]">Dag {dayNum}</span>
                  <span class="text-[10px] font-mono uppercase tracking-[0.15em] text-[var(--color-muted)] hidden" data-day-filled={`${stop.id}-${dayNum}`}>● Gevuld</span>
                  <svg class="transition-transform group-open:rotate-180" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-muted)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m6 9 6 6 6-6"/>
                  </svg>
                </summary>
                <div class="px-4 pb-4">
                  <textarea
                    data-day-input={`${stop.id}-${dayNum}`}
                    placeholder="Ochtend: …&#10;Middag: …&#10;Avond: …"
                    rows="4"
                    class="w-full bg-[var(--color-deep)] border border-[var(--color-line)] rounded-xl p-3 text-sm text-[var(--color-ink)] placeholder:text-[var(--color-muted)] focus:outline-none focus:border-[var(--color-azure)] resize-y leading-relaxed"
                  ></textarea>
                </div>
              </details>
            ))}
          </div>
        </div>

        <div role="tabpanel" data-tab-panel="2" class="p-5 sm:p-6 pt-2 hidden">
          <div class="flex items-center justify-between mb-3">
            <div>
              <div class="text-sm font-semibold text-[var(--color-ink)]">Notities</div>
              <div class="text-xs text-[var(--color-muted)]">Lokaal opgeslagen in je browser</div>
            </div>
            <div class="text-[10px] font-mono uppercase tracking-[0.15em] text-[var(--color-aqua)] opacity-0 transition-opacity" data-notes-saved>
              ✓ Opgeslagen
            </div>
          </div>
          <textarea
            data-notes-input
            data-stop-id={stop.id}
            placeholder="Eigen aantekeningen, tips, contacten, must-do's…"
            rows="6"
            class="w-full bg-[var(--color-night)] border border-[var(--color-line)] rounded-2xl p-4 text-sm text-[var(--color-ink)] placeholder:text-[var(--color-muted)] focus:outline-none focus:border-[var(--color-azure)] resize-y leading-relaxed"
          ></textarea>
        </div>

        <div role="tabpanel" data-tab-panel="3" class="p-5 sm:p-6 pt-2 hidden">
          <div class="flex items-center justify-between mb-3">
            <div>
              <div class="text-sm font-semibold text-[var(--color-ink)]">Documenten</div>
              <div class="text-xs text-[var(--color-muted)]">Drop bestanden in <span class="font-mono text-[var(--color-aqua)]">/public/uploads/{stop.id}/</span></div>
            </div>
          </div>
          {stop.documents && stop.documents.length > 0 ? (
            <ul class="space-y-2">
              {stop.documents.map((doc) => (
                <li class="flex items-center gap-3 p-3 rounded-2xl bg-[var(--color-night)] border border-[var(--color-line)]">
                  <div class={`w-9 h-9 rounded-xl grid place-items-center shrink-0 ${doc.file ? "bg-[var(--color-aqua)]/15 border border-[var(--color-aqua)]/30" : "bg-[var(--color-card)] border border-[var(--color-line)] border-dashed"}`}>
                    {doc.file ? (
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-aqua)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/>
                      </svg>
                    ) : (
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 5v14"/><path d="M5 12h14"/>
                      </svg>
                    )}
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="text-sm font-medium text-[var(--color-ink)] truncate">{doc.label}</div>
                    {doc.note && <div class="text-xs text-[var(--color-muted)] truncate">{doc.note}</div>}
                  </div>
                  {doc.file ? (
                    <a href={doc.file} target="_blank" rel="noopener" class="shrink-0 px-3 py-1.5 rounded-full bg-[var(--color-azure)] text-white text-xs font-medium hover:bg-[var(--color-electric)] transition">
                      Open
                    </a>
                  ) : (
                    <span class="shrink-0 text-[10px] font-mono uppercase tracking-[0.15em] text-[var(--color-muted)]">
                      Leeg
                    </span>
                  )}
                </li>
              ))}
            </ul>
          ) : (
            <div class="p-6 rounded-2xl bg-[var(--color-night)] border border-dashed border-[var(--color-line)] text-center text-sm text-[var(--color-muted)]">
              Nog geen documenten
            </div>
          )}
        </div>

        <div role="tabpanel" data-tab-panel="4" class="p-5 sm:p-6 pt-2 hidden">
          <div class="flex items-center justify-between mb-3">
            <div>
              <div class="text-sm font-semibold text-[var(--color-ink)]">Foto's</div>
              <div class="text-xs text-[var(--color-muted)]">Drop foto's in <span class="font-mono text-[var(--color-aqua)]">/public/uploads/photos/{stop.id}/</span></div>
            </div>
          </div>
          {stop.photos && stop.photos.length > 0 ? (
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
              {stop.photos.map((photo) => (
                <a href={photo} target="_blank" rel="noopener" class="relative aspect-square rounded-2xl overflow-hidden bg-[var(--color-night)] group">
                  <img src={photo} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform group-hover:scale-105" loading="lazy" decoding="async" />
                </a>
              ))}
            </div>
          ) : (
            <div class="aspect-[4/3] sm:aspect-[16/9] rounded-2xl bg-[var(--color-night)] border border-dashed border-[var(--color-line)] grid place-items-center text-center p-6">
              <div>
                <div class="mx-auto mb-3 w-10 h-10 rounded-xl grid place-items-center bg-[var(--color-card)]">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.5-3.5-9 9"/>
                  </svg>
                </div>
                <div class="text-sm text-[var(--color-ink)]">Geen foto's nog</div>
                <div class="text-xs text-[var(--color-muted)] mt-1">Voeg ze toe via de uploads-folder</div>
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </article>
</div>
