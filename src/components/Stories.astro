---
import { stops } from "../data/trip";

const slides = stops.map((s, i) => ({
  id: s.id,
  index: i + 1,
  city: s.city,
  region: s.region,
  tagline: s.tagline,
  vibe: s.vibe,
  arrival: s.arrival,
  departure: s.departure,
  nights: s.nights,
  image: s.image,
  isHome: s.nights >= 10,
  highlights: s.highlights
}));
---


<div
  data-stories-modal
  class="hidden fixed inset-0 z-[100] bg-black"
  role="dialog"
  aria-modal="true"
  aria-label="Trip stories"
>
  <div data-stories-progress class="absolute top-0 left-0 right-0 flex gap-1 p-2 z-20 pointer-events-none">
    {slides.map((_, i) => (
      <div class="flex-1 h-0.5 bg-white/30 rounded-full overflow-hidden">
        <div data-progress-bar={i} class="h-full bg-white" style="width: 0%"></div>
      </div>
    ))}
  </div>

  <button
    type="button"
    data-stories-close
    class="absolute top-3 right-3 z-30 w-10 h-10 rounded-full bg-white/15 backdrop-blur-md border border-white/30 grid place-items-center text-white active:scale-95 transition"
    aria-label="Sluit stories"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M18 6 6 18M6 6l12 12"/>
    </svg>
  </button>

  <div data-stories-track class="flex w-full h-full transition-transform duration-300 ease-out" style="transform: translateX(0%)">
    {slides.map((slide) => (
      <div data-story-slide={slide.id} class="shrink-0 w-full h-full relative">
        <img
          src={slide.image}
          alt={slide.city}
          class="absolute inset-0 w-full h-full object-cover"
          loading="lazy"
          decoding="async"
        />
        <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.15) 25%, rgba(0,0,0,0.25) 60%, rgba(0,0,0,0.95) 100%);"></div>

        <div class="absolute top-12 left-5 right-5 flex items-center gap-3 z-10">
          <div class={`w-10 h-10 rounded-full grid place-items-center font-display font-bold text-sm ${slide.isHome ? "bg-[var(--color-coral)] text-white" : "bg-[var(--color-azure)] text-white"}`}>
            {String(slide.index).padStart(2, "0")}
          </div>
          <div class="flex-1 min-w-0">
            <div class="text-[10px] font-mono uppercase tracking-[0.2em] text-white/85">{slide.region}</div>
            <div class="text-sm font-medium text-white">{slide.arrival} → {slide.departure} · {slide.nights}n</div>
          </div>
        </div>

        <div class="absolute bottom-0 left-0 right-0 p-6 pb-10 z-10">
          <h2 class="font-display font-bold text-[15vw] sm:text-7xl leading-[0.85] tracking-[-0.03em] text-white mb-3" style="text-shadow: 0 4px 24px rgba(0,0,0,0.4);">
            {slide.city}
          </h2>
          <p class="text-lg italic font-light text-white/95 mb-4" style="text-shadow: 0 1px 4px rgba(0,0,0,0.5);">
            {slide.tagline}
          </p>
          <p class="text-sm text-white/85 leading-relaxed mb-5" style="text-shadow: 0 1px 4px rgba(0,0,0,0.5);">
            {slide.vibe}
          </p>
          <div class="flex flex-wrap gap-2 mb-5">
            {slide.highlights.slice(0, 3).map((h) => (
              <span class="px-3 py-1.5 rounded-full bg-white/15 backdrop-blur-md border border-white/25 text-xs text-white">
                {h}
              </span>
            ))}
          </div>
          <a
            href={`#stop-${slide.id}`}
            data-stories-jump={slide.id}
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-white text-[var(--color-ink)] text-sm font-semibold active:scale-95 transition"
          >
            Open details
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>
            </svg>
          </a>
        </div>

        <div class="absolute inset-y-0 left-0 w-1/3 z-0" data-stories-area="prev"></div>
        <div class="absolute inset-y-0 right-0 w-1/3 z-0" data-stories-area="next"></div>
      </div>
    ))}
  </div>
</div>

<script is:inline>
  (function () {
    const modal = document.querySelector("[data-stories-modal]");
    const track = document.querySelector("[data-stories-track]");
    const openBtns = document.querySelectorAll("[data-stories-open]");
    const closeBtn = document.querySelector("[data-stories-close]");
    const slides = document.querySelectorAll("[data-story-slide]");
    const total = slides.length;
    let current = 0;
    let timer = null;
    const STORY_MS = 6000;

    if (!modal || !track || total === 0) return;

    const setProgressBars = (currentIdx, fraction) => {
      document.querySelectorAll("[data-progress-bar]").forEach((bar) => {
        const i = Number(bar.dataset.progressBar);
        if (i < currentIdx) bar.style.width = "100%";
        else if (i === currentIdx) bar.style.width = (fraction * 100) + "%";
        else bar.style.width = "0%";
      });
    };

    const advance = (next) => {
      if (next < 0 || next >= total) {
        close();
        return;
      }
      current = next;
      track.style.transform = `translateX(-${current * 100}%)`;
      setProgressBars(current, 0);
      startTimer();
    };

    const startTimer = () => {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
      let start = performance.now();
      const tick = () => {
        const elapsed = performance.now() - start;
        const frac = Math.min(1, elapsed / STORY_MS);
        setProgressBars(current, frac);
        if (frac >= 1) {
          advance(current + 1);
        } else {
          timer = requestAnimationFrame(tick);
        }
      };
      timer = requestAnimationFrame(tick);
    };

    const open = () => {
      modal.classList.remove("hidden");
      document.body.style.overflow = "hidden";
      current = 0;
      track.style.transform = "translateX(0%)";
      setProgressBars(0, 0);
      startTimer();
    };

    const close = () => {
      modal.classList.add("hidden");
      document.body.style.overflow = "";
      if (timer) {
        cancelAnimationFrame(timer);
        timer = null;
      }
    };

    openBtns.forEach((btn) => btn.addEventListener("click", open));
    closeBtn?.addEventListener("click", close);

    // tap left/right areas for prev/next
    document.querySelectorAll("[data-stories-area]").forEach((area) => {
      area.addEventListener("click", (e) => {
        e.stopPropagation();
        if (area.dataset.storiesArea === "prev") advance(current - 1);
        else advance(current + 1);
      });
    });

    // jump button: close modal and navigate to stop
    document.querySelectorAll("[data-stories-jump]").forEach((btn) => {
      btn.addEventListener("click", () => {
        close();
        // hashchange in main page will open card
      });
    });

    // swipe support
    let touchStart = 0;
    let touchEnd = 0;
    track.addEventListener("touchstart", (e) => {
      touchStart = e.changedTouches[0].screenX;
      if (timer) {
        cancelAnimationFrame(timer);
        timer = null;
      }
    }, { passive: true });
    track.addEventListener("touchend", (e) => {
      touchEnd = e.changedTouches[0].screenX;
      const diff = touchStart - touchEnd;
      if (Math.abs(diff) > 50) {
        if (diff > 0) advance(current + 1);
        else advance(current - 1);
      } else {
        startTimer();
      }
    }, { passive: true });

    // keyboard
    window.addEventListener("keydown", (e) => {
      if (modal.classList.contains("hidden")) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft") advance(current - 1);
      else if (e.key === "ArrowRight") advance(current + 1);
    });
  })();
</script>

<style>
  [data-stories-open].fixed {
    top: env(safe-area-inset-top, 12px);
  }
</style>
