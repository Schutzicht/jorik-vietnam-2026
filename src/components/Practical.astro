---
import { practical, trip } from "../data/trip";

const iconMap: Record<string, string> = {
  Visum: '<path d="M21 8v13H3V8"/><path d="M1 3h22v5H1z"/><path d="M10 12h4"/>',
  Geld: '<circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 0 0 0 4h4a2 2 0 0 1 0 4H8"/>',
  SIM: '<rect x="4" y="2" width="16" height="20" rx="2"/><rect x="9" y="9" width="6" height="6"/>',
  Budget: '<path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/>',
  "Surf gear": '<path d="M3 16c3-3 5-3 9 0s6 3 9 0"/><path d="M3 11c3-3 5-3 9 0s6 3 9 0"/>',
  Packing: '<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>',
  "Weer okt": '<circle cx="12" cy="12" r="5"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2"/>',
  Apps: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>'
};
---

<section id="praktisch" class="relative bg-[var(--color-deep)] py-14 sm:py-20">
  <div class="max-w-3xl mx-auto px-5 sm:px-8">
    <div class="mb-8 sm:mb-12">
      <div class="text-xs font-mono uppercase tracking-[0.22em] text-[var(--color-aqua)] mb-2">
        Info
      </div>
      <h2 class="font-display font-bold text-3xl sm:text-5xl leading-[1] tracking-tight">
        Praktisch.
      </h2>
    </div>

    <div class="rounded-3xl overflow-hidden bg-[var(--color-night)] border border-[var(--color-line)] divide-y divide-[var(--color-line)] mb-8">
      {practical.map((item) => (
        <details class="group">
          <summary class="flex items-center gap-4 p-4 sm:p-5 cursor-pointer list-none hover:bg-[var(--color-deep)]/50 transition-colors">
            <div class="w-9 h-9 rounded-xl grid place-items-center bg-[var(--color-azure)]/10 border border-[var(--color-azure)]/30 shrink-0">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--color-aqua)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconMap[item.title] || '<circle cx="12" cy="12" r="10"/>'} />
            </div>
            <span class="flex-1 text-sm sm:text-base font-semibold text-[var(--color-ink)]">{item.title}</span>
            <svg class="shrink-0 transition-transform group-open:rotate-180" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-muted)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m6 9 6 6 6-6"/>
            </svg>
          </summary>
          <div class="px-4 sm:px-5 pb-5 pl-[68px] sm:pl-[72px] text-sm text-[var(--color-ink-soft)] leading-relaxed">
            {item.body}
          </div>
        </details>
      ))}
    </div>

    <div class="rounded-3xl overflow-hidden bg-[var(--color-night)] border border-[var(--color-line)]">
      <div class="flex items-center justify-between p-4 sm:p-5 border-b border-[var(--color-line)]">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl grid place-items-center bg-[var(--color-azure)]/10 border border-[var(--color-azure)]/30">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--color-aqua)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>
            </svg>
          </div>
          <span class="text-sm sm:text-base font-semibold text-[var(--color-ink)]">Vluchten</span>
        </div>
        <span class="text-[10px] font-mono uppercase tracking-[0.15em] text-[var(--color-muted)]">{trip.flights.length} legs</span>
      </div>
      <ol class="divide-y divide-[var(--color-line)]">
        {trip.flights.map((flight, i) => (
          <li>
            <details class="group">
              <summary class="flex items-center gap-3 sm:gap-4 p-4 sm:p-5 cursor-pointer list-none hover:bg-[var(--color-deep)]/40 transition-colors">
                <span class="font-mono text-[10px] w-7 h-7 rounded-full grid place-items-center shrink-0 bg-[var(--color-card)] text-[var(--color-aqua)] font-bold">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-0.5">
                    <span class="text-[10px] font-mono uppercase tracking-[0.18em] text-[var(--color-aqua)]">{flight.kind}</span>
                    {flight.date && <span class="text-[10px] font-mono text-[var(--color-muted)]">· {flight.date}</span>}
                  </div>
                  <div class="font-display font-bold text-base sm:text-lg text-[var(--color-ink)] tracking-tight leading-none">
                    {flight.from} <span class="text-[var(--color-aqua)] mx-1">→</span> {flight.to}
                  </div>
                </div>
                <span class={`shrink-0 text-[10px] font-mono uppercase tracking-[0.15em] ${flight.file ? "text-[var(--color-aqua)]" : "text-[var(--color-muted)]"}`}>
                  {flight.file ? "Geboekt" : "Open"}
                </span>
                <svg class="shrink-0 transition-transform group-open:rotate-180" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-muted)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m6 9 6 6 6-6"/>
                </svg>
              </summary>

              <div class="px-4 sm:px-5 pb-5 pt-1 pl-[60px] sm:pl-[68px]">
                <div class="flex items-baseline gap-3 mb-4 text-[var(--color-ink)]">
                  <div class="text-right">
                    <div class="font-display font-bold text-2xl sm:text-3xl tracking-tight leading-none">{flight.from}</div>
                    <div class="text-[10px] font-mono uppercase tracking-[0.12em] text-[var(--color-muted)] mt-1">{flight.fromCity}</div>
                  </div>
                  <div class="flex-1 flex items-center gap-1.5 px-2">
                    <span class="h-px flex-1 bg-[var(--color-line-strong)]"></span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-aqua)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m12 19 9 2-9-18-9 18 9-2zm0 0v-8"/>
                    </svg>
                    <span class="h-px flex-1 bg-[var(--color-line-strong)]"></span>
                  </div>
                  <div>
                    <div class="font-display font-bold text-2xl sm:text-3xl tracking-tight leading-none">{flight.to}</div>
                    <div class="text-[10px] font-mono uppercase tracking-[0.12em] text-[var(--color-muted)] mt-1">{flight.toCity}</div>
                  </div>
                </div>

                <dl class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
                  <div>
                    <dt class="text-[9px] font-mono uppercase tracking-[0.18em] text-[var(--color-muted)] mb-0.5">Datum</dt>
                    <dd class={`text-sm font-medium ${flight.date ? "text-[var(--color-ink)]" : "text-[var(--color-muted)] italic"}`}>{flight.date || "Nog niet"}</dd>
                  </div>
                  <div>
                    <dt class="text-[9px] font-mono uppercase tracking-[0.18em] text-[var(--color-muted)] mb-0.5">Tijd</dt>
                    <dd class={`text-sm font-medium ${flight.time ? "text-[var(--color-ink)]" : "text-[var(--color-muted)] italic"}`}>{flight.time || "Nog niet"}</dd>
                  </div>
                  <div>
                    <dt class="text-[9px] font-mono uppercase tracking-[0.18em] text-[var(--color-muted)] mb-0.5">Duur</dt>
                    <dd class={`text-sm font-medium ${flight.duration ? "text-[var(--color-ink)]" : "text-[var(--color-muted)] italic"}`}>{flight.duration || "..."}</dd>
                  </div>
                  <div>
                    <dt class="text-[9px] font-mono uppercase tracking-[0.18em] text-[var(--color-muted)] mb-0.5">Airline</dt>
                    <dd class={`text-sm font-medium ${flight.airline ? "text-[var(--color-ink)]" : "text-[var(--color-muted)] italic"}`}>{flight.airline || "Nog niet"}</dd>
                  </div>
                  <div>
                    <dt class="text-[9px] font-mono uppercase tracking-[0.18em] text-[var(--color-muted)] mb-0.5">Vlucht-nr</dt>
                    <dd class={`text-sm font-medium font-mono ${flight.flightNo ? "text-[var(--color-ink)]" : "text-[var(--color-muted)] italic"}`}>{flight.flightNo || "..."}</dd>
                  </div>
                  <div class="col-span-1 sm:col-span-3">
                    <dt class="text-[9px] font-mono uppercase tracking-[0.18em] text-[var(--color-muted)] mb-0.5">Booking ref</dt>
                    <dd class={`text-sm font-medium font-mono ${flight.bookingRef ? "text-[var(--color-ink)]" : "text-[var(--color-muted)] italic"}`}>{flight.bookingRef || "Nog niet"}</dd>
                  </div>
                </dl>

                {flight.note && (
                  <p class="text-xs text-[var(--color-ink-soft)] leading-relaxed mb-4 px-3 py-2.5 rounded-xl bg-[var(--color-deep)]/60 border border-[var(--color-line)]">
                    {flight.note}
                  </p>
                )}

                {flight.file ? (
                  <a href={flight.file} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-[var(--color-azure)] text-white text-sm font-medium hover:bg-[var(--color-electric)] transition">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/>
                    </svg>
                    Boarding pass openen
                  </a>
                ) : (
                  <div class="inline-flex items-center gap-2 px-3 py-2 rounded-full border border-dashed border-[var(--color-line-strong)] text-xs font-mono uppercase tracking-[0.15em] text-[var(--color-muted)]">
                    Drop PDF in /uploads/ en zet pad in trip.ts
                  </div>
                )}
              </div>
            </details>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<footer class="bg-[var(--color-night)] border-t border-[var(--color-line)] py-8 sm:py-10">
  <div class="max-w-3xl mx-auto px-5 sm:px-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div class="text-xs text-[var(--color-muted)]">Vietnam · Okt 2026 · persoonlijke itinerary</div>
    <div class="text-[10px] text-[var(--color-muted)] font-mono">
      Edit: <span class="text-[var(--color-aqua)]">src/data/trip.ts</span>
    </div>
  </div>
</footer>
