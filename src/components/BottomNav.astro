---
const items = [
  {
    id: "top",
    label: "Trip",
    href: "#top",
    icon: '<path d="m3 11 19-9-9 19-2-8-8-2z"/>'
  },
  {
    id: "kaart",
    label: "Map",
    href: "#kaart",
    icon: '<path d="M9 20 3 17V4l6 3"/><path d="m15 21 6-3V5l-6 3"/><path d="M9 7v13"/><path d="M15 8v13"/>'
  },
  {
    id: "stops",
    label: "Stops",
    href: "#stops",
    icon: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>'
  },
  {
    id: "praktisch",
    label: "Info",
    href: "#praktisch",
    icon: '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>'
  }
];
---

<nav
  class="md:hidden fixed bottom-0 left-0 right-0 z-50 pb-[env(safe-area-inset-bottom)] pointer-events-none"
  aria-label="Navigatie"
>
  <div class="mx-3 mb-3 pointer-events-auto">
    <div class="glass rounded-3xl px-2 py-2 grid grid-cols-4 gap-1 soft-shadow">
      {items.map((item) => (
        <a
          href={item.href}
          data-target={item.id}
          class="bn-item flex flex-col items-center gap-1 py-2 rounded-2xl transition active:scale-95"
        >
          <span class="bn-icon w-9 h-9 rounded-xl grid place-items-center bg-transparent text-[var(--color-ink-soft)] transition-colors">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={item.icon} />
          </span>
          <span class="bn-label text-[10px] font-medium text-[var(--color-muted)] transition-colors">
            {item.label}
          </span>
        </a>
      ))}
    </div>
  </div>
</nav>
