---
import { stops, pois } from "../data/trip";

const mapData = stops.map((s, i) => ({
  id: s.id,
  city: s.city,
  region: s.region,
  arrival: s.arrival,
  departure: s.departure,
  nights: s.nights,
  coords: s.coords,
  index: i + 1,
  isHome: s.nights >= 10,
  sideTrips: s.sideTrips ?? []
}));
const mapDataJson = JSON.stringify(mapData);
const poisJson = JSON.stringify(pois);

const layers = [
  { id: "surf", label: "Surf", color: "#0284c7", icon: '<path d="M2 16c3-2 5-2 8 0s5 2 8 0 3-2 4-2"/><path d="M6 11c2 0 3 2 6 2s4-2 6-2 2 1 4 1"/>' },
  { id: "food", label: "Eten", color: "#e85a4f", icon: '<path d="M4 11h16v3a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4z"/><path d="M8 7v3"/><path d="M12 5v5"/><path d="M16 7v3"/>' },
  { id: "cowork", label: "Cowork", color: "#7c3aed", icon: '<rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 18v3"/>' },
  { id: "photo", label: "Foto", color: "#f59e0b", icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.5-3.5-9 9"/>' }
];
const layersJson = JSON.stringify(layers);
---

<section id="kaart" class="relative py-12 sm:py-16 bg-[var(--color-night)] overflow-hidden">
  <div class="absolute inset-0 pointer-events-none">
    <div class="blob" style="width: 500px; height: 500px; background: #0ea5e9; top: -100px; left: -100px; opacity: 0.15;"></div>
  </div>

  <div class="relative max-w-3xl mx-auto px-5 sm:px-8">
    <div class="mb-6 sm:mb-8 flex items-end justify-between gap-4">
      <div>
        <div class="text-xs font-mono uppercase tracking-[0.22em] text-[var(--color-aqua)] mb-2">
          Route
        </div>
        <h2 class="font-display font-bold text-3xl sm:text-5xl leading-[1] tracking-tight">
          De kaart.
        </h2>
      </div>
      <ul class="flex flex-wrap gap-2 text-[10px] font-mono uppercase tracking-[0.12em]">
        <li class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-full glass">
          <span class="inline-block w-2 h-2 rounded-full" style="background: var(--color-azure);"></span>
          <span class="text-[var(--color-ink-soft)]">Stop</span>
        </li>
        <li class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-full glass">
          <span class="inline-block w-2.5 h-2.5 rounded-full" style="background: var(--color-coral);"></span>
          <span class="text-[var(--color-ink-soft)]">Home</span>
        </li>
        <li class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-full glass">
          <span class="inline-block w-2 h-2 rounded-full border-2 border-[var(--color-aqua)]"></span>
          <span class="text-[var(--color-ink-soft)]">Side</span>
        </li>
      </ul>
    </div>

    <div class="mb-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div class="inline-flex p-0.5 rounded-full bg-[var(--color-deep)] border border-[var(--color-line)] self-start">
        <button
          type="button"
          data-view="homebase"
          data-active="true"
          class="view-btn px-3 py-1.5 rounded-full text-xs font-medium transition"
        >
          Homebase
        </button>
        <button
          type="button"
          data-view="all"
          data-active="false"
          class="view-btn px-3 py-1.5 rounded-full text-xs font-medium transition"
        >
          Hele trip
        </button>
      </div>

      <div class="flex flex-wrap gap-2" data-layer-toggles>
        {layers.map((layer) => (
          <button
            type="button"
            data-layer={layer.id}
            data-active="false"
            class="layer-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[var(--color-deep)] border border-[var(--color-line)] text-xs font-medium text-[var(--color-ink)] hover:border-[var(--color-azure)]/40 transition active:scale-95"
          >
            <span class="layer-dot inline-block w-2 h-2 rounded-full" style={`background: ${layer.color}; opacity: 0.4`}></span>
            {layer.label}
          </button>
        ))}
      </div>
    </div>

    <div
      data-reveal
      class="relative w-full h-[440px] sm:h-[560px] rounded-3xl overflow-hidden ring-azure"
    >
      <div id="route-map" class="absolute inset-0"></div>
      <div class="absolute top-4 left-4 z-[400] glass-dark px-3 py-1.5 rounded-full text-[10px] font-mono uppercase tracking-[0.15em] text-white pointer-events-none">
        <span class="text-[var(--color-aqua)]">●</span> Route · Okt 2026
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ mapDataJson, poisJson, layersJson }}>
    function initRouteMap() {
      if (typeof window.L === "undefined") {
        window.setTimeout(initRouteMap, 60);
        return;
      }
      const L = window.L;
      const data = JSON.parse(mapDataJson);
      const poisData = JSON.parse(poisJson);
      const layersData = JSON.parse(layersJson);
      const el = document.getElementById("route-map");
      if (!el) return;
      if (el.dataset.inited === "1") return;
      el.dataset.inited = "1";

      const map = L.map(el, {
        zoomControl: true,
        scrollWheelZoom: false,
        attributionControl: true,
        tap: true
      });

      L.tileLayer(
        "https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png",
        {
          attribution:
            '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
          maxZoom: 19,
          subdomains: "abcd"
        }
      ).addTo(map);

      const bounds = L.latLngBounds([]);

      data.forEach((stop) => {
        const icon = L.divIcon({
          html: `<div class="stop-pin ${stop.isHome ? "is-home" : ""}"><div class="stop-pin__inner">${stop.index}</div></div>`,
          className: "",
          iconSize: stop.isHome ? [50, 50] : [38, 38],
          iconAnchor: stop.isHome ? [25, 25] : [19, 19]
        });
        const m = L.marker(stop.coords, { icon }).addTo(map);
        m.bindPopup(
          `<strong>${stop.city}</strong>
           <span style="color: var(--color-muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em;">${stop.region}</span><br/>
           <span style="font-size: 12px; color: var(--color-ink-soft);">${stop.arrival} &ndash; ${stop.departure} &middot; ${stop.nights} nachten</span><br/>
           <a href="#stop-${stop.id}" style="color: var(--color-aqua); font-size: 12px; font-weight: 600; margin-top: 6px; display: inline-block;">Naar details &rarr;</a>`
        );
        bounds.extend(stop.coords);

        (stop.sideTrips || []).forEach((side) => {
          if (!side.coords) return;
          const sideIcon = L.divIcon({
            html: `<div class="side-pin"></div>`,
            className: "",
            iconSize: [14, 14],
            iconAnchor: [7, 7]
          });
          const sm = L.marker(side.coords, { icon: sideIcon }).addTo(map);
          sm.bindPopup(
            `<strong>${side.name}</strong>
             <span style="color: var(--color-muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em;">Side trip · ${stop.city}</span><br/>
             <span style="font-size: 12px; color: var(--color-ink-soft);">${side.distance} &middot; ${side.duration}</span>`
          );
          bounds.extend(side.coords);
        });
      });

      const stopCoords = data.map((d) => d.coords);
      L.polyline(stopCoords, {
        color: "#0284c7",
        weight: 3,
        opacity: 0.85,
        dashArray: "2 10",
        lineCap: "round"
      }).addTo(map);

      // Two views: homebase (Da Nang region) and all stops
      const homebaseBounds = L.latLngBounds([
        [15.6, 107.3],
        [16.7, 108.6]
      ]);
      const allBounds = bounds;

      const applyView = (view) => {
        if (view === "all") {
          map.fitBounds(allBounds, { padding: [60, 60] });
        } else {
          map.fitBounds(homebaseBounds, { padding: [40, 40] });
        }
      };

      applyView("homebase");

      document.querySelectorAll("[data-view]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const view = btn.dataset.view;
          document.querySelectorAll("[data-view]").forEach((b) => {
            b.dataset.active = b === btn ? "true" : "false";
          });
          applyView(view);
        });
      });

      // POI layers
      const poiLayers = {};
      layersData.forEach((layer) => {
        const items = poisData.filter((p) => p.type === layer.id);
        const layerGroup = L.layerGroup();
        items.forEach((p) => {
          const icon = L.divIcon({
            html: `<div class="poi-pin" style="background: ${layer.color}"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${layer.icon}</svg></div>`,
            className: "",
            iconSize: [22, 22],
            iconAnchor: [11, 11]
          });
          const marker = L.marker(p.coords, { icon });
          marker.bindPopup(
            `<strong>${p.name}</strong>
             <span style="color: var(--color-muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em;">${layer.label}</span>
             ${p.note ? `<br/><span style="font-size: 12px; color: var(--color-ink-soft);">${p.note}</span>` : ""}`
          );
          layerGroup.addLayer(marker);
        });
        poiLayers[layer.id] = layerGroup;
      });

      // Layer toggles
      document.querySelectorAll("[data-layer]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const id = btn.dataset.layer;
          const isActive = btn.dataset.active === "true";
          const layer = poiLayers[id];
          if (!layer) return;
          if (isActive) {
            map.removeLayer(layer);
            btn.dataset.active = "false";
            btn.classList.remove("border-[var(--color-azure)]", "bg-[var(--color-azure)]/5");
            const dot = btn.querySelector(".layer-dot");
            if (dot) dot.style.opacity = "0.4";
          } else {
            layer.addTo(map);
            btn.dataset.active = "true";
            btn.classList.add("border-[var(--color-azure)]", "bg-[var(--color-azure)]/5");
            const dot = btn.querySelector(".layer-dot");
            if (dot) dot.style.opacity = "1";
          }
        });
      });

      // React to mood:change event
      window.addEventListener("mood:change", (e) => {
        const recommends = {
          surf: ["surf"],
          werk: ["cowork"],
          verkennen: ["photo", "food"],
          chill: ["food"]
        }[e.detail] || [];
        document.querySelectorAll("[data-layer]").forEach((btn) => {
          const id = btn.dataset.layer;
          const shouldShow = recommends.includes(id);
          const isActive = btn.dataset.active === "true";
          if (shouldShow && !isActive) btn.click();
          if (!shouldShow && isActive && e.detail) btn.click();
        });
      });

      // Recalculate after fonts/images settle - mobile-safe
      window.setTimeout(() => map.invalidateSize(), 200);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initRouteMap);
    } else {
      initRouteMap();
    }
  </script>
</section>
